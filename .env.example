# ── PHUONG AN (a): tac nhan nghien cuu + viet, Gemini chi sinh anh ──────────
# Chay:  ficool yeu-cau 10  ->  dien dau-vao/*.yaml  ->  ficool lo 10 --nghien-cuu=toi --viet=toi
# Che do do CHI can GEMINI_API_KEY. Ba khoa duoi (SERPER, GSC) chi can khi
# --nghien-cuu=gemini; nhom WP_* chi can khi --dang-bai=rest|novamira.
# ───────────────────────────────────────────────────────────────────────────

# Google AI Studio — sinh bài, nghiên cứu (Google Search grounding) và sinh ảnh.
# Cố ý KHÔNG đặt tên GOOGLE_API_KEY: kho này đã có GOOGLE_APPLICATION_CREDENTIALS_JSON
# cho Search Console, hai biến GOOGLE_* cạnh nhau với ý nghĩa khác hẳn là mời gọi nhầm.
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.8-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_IMAGE_SIZE=1K

# Search Console (service account, KHÔNG phải khoá Gemini)
GSC_SITE_URL=
GOOGLE_APPLICATION_CREDENTIALS=
GSC_LOOKBACK_DAYS=90

SERPER_API_KEY=
SERP_NUM_RESULTS=10
SERP_COUNTRY=vn
SERP_LANGUAGE=vi

WP_URL=
WP_USERNAME=
WP_APPLICATION_PASSWORD=

FICOOL_MAX_ARTICLES_PER_RUN=1
